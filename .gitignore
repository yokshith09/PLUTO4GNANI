# Build output
/target/
**/target/
node_modules/
dist/
ui/dist/

# Local secrets and config. Keys live in the OS keychain at runtime.
.env
.env.local

# Recordings and app data must never be committed
*.wav
!test-data/audio/**/*.wav
recordings/
app-data/

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# From the ported base
coverage/
*.tsbuildinfo
/src-tauri/gen/
/spikes/
packs/*/atlas.svg
packs/*/spritesheet.png
packs/*/strips.svg
packs/*/strips/
packs/*/build/
__pycache__/
*.pyc
*.log

# Generated by cargo test (ts-rs); the committed copy lives in src/ipc/generated
crates/pluto-core/bindings/
